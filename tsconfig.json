{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@party/avalon": ["packages/avalon/src/index.ts"],
      "@party/contracts": ["packages/contracts/src/index.ts"],
      "@party/domain": ["packages/domain/src/index.ts"],
      "@party/persistence": ["packages/persistence/src/index.ts"],
      "@party/poker": ["packages/poker/src/index.ts"],
      "@party/test-support": ["packages/test-support/src/index.ts"]
    }
  },
  "include": ["apps/**/*.ts", "apps/**/*.tsx", "packages/**/*.ts", "tests/**/*.ts"]
}
