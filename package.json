{
  "name": "home-party-game-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:platform": "vitest run tests/platform.test.ts tests/server.test.ts",
    "test:poker": "vitest run tests/poker.test.ts",
    "test:realtime": "vitest run tests/realtime.test.ts",
    "test:e2e:core": "node scripts/run-e2e.mjs",
    "test:capacity": "vitest run tests/capacity.test.ts",
    "test": "vitest run",
    "build:server": "tsup apps/server/src/index.ts --format esm --platform node --out-dir dist/server --sourcemap",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "build": "npm run build:web && npm run build:server && node scripts/verify-static-assets.mjs",
    "verify:core": "npm run lint && npm run typecheck && npm run test:platform && npm run test:poker && npm run test:realtime && npm run test:e2e:core",
    "test:docker-smoke": "node tests/docker-smoke.mjs"
  },
  "dependencies": {
    "@fastify/static": "^8.0.0",
    "@fastify/websocket": "^11.0.0",
    "better-sqlite3": "^11.8.0",
    "fastify": "^5.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "1.55.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.0.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.0.0",
    "playwright": "1.55.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vite": "6.1.0",
    "vitest": "^3.0.0"
  }
}
